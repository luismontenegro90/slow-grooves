---
import '../styles/global.css';
import Motion from './Motion.astro';
import {albumMarkup} from '../lib/album-view.mjs';
const {record} = Astro.props;
const projectId=import.meta.env.PUBLIC_SANITY_PROJECT_ID || 'ovzh9fkm';
const dataset=import.meta.env.PUBLIC_SANITY_DATASET || 'production';
const title=record?`${record.title} — ${record.artist} | Slow Grooves`:'The listening room | Slow Grooves';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={record?`${record.title} by ${record.artist}: the tracklist, Spotify player, and a closer look at the vinyl.`:'Explore the collection, one record at a time.'}/><link rel="icon" href="/favicon.svg"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"/></head><body class="album-page"><header><a class="brand" href="/">slow grooves<span class="brand-dot">®</span></a><nav aria-label="Main navigation"><a href="/#collection">The collection</a><a href="/#ritual">The ritual</a></nav><span class="header-note">The listening room</span></header><main class="album-page-main"><a class="back-collection" href="/#collection">Back to the collection</a><div id="album-content" data-record-id={record?._id||''} data-project-id={projectId} data-dataset={dataset} set:html={record?albumMarkup(record):'<p class="album-loading" role="status">Opening the listening room…</p>'}></div><p id="album-status" role="status" hidden></p></main><footer><a class="brand" href="/">slow grooves®</a><span>One record. Your whole attention.</span><a href="/#collection">Explore the collection</a></footer><script>
import {albumMarkup} from '../lib/album-view.mjs';
const content=document.querySelector('#album-content');const params=new URLSearchParams(location.search);const id=content.dataset.recordId||params.get('id');const status=document.querySelector('#album-status');
if(id){const query='*[_type == "vinyl" && _id == $id && !(_id in path("drafts.**"))][0]{_id,rank,title,artist,year,genre,note,favoriteTrack,spotifyUrl,tracklist,tracklistEdition,tracklistSource,vinylEdition,"vinylPhotos":vinylPhotos[]{"url":asset->url,alt,credit,sourceUrl},"cover":cover.asset->url}';const url=new URL(`https://${content.dataset.projectId}.api.sanity.io/v2026-06-09/data/query/${content.dataset.dataset}`);url.searchParams.set('query',query);url.searchParams.set('$id',JSON.stringify(id));url.searchParams.set('perspective','published');fetch(url).then(r=>{if(!r.ok)throw Error();return r.json();}).then(d=>{if(!d.result){if(!content.dataset.recordId)content.innerHTML='<p>This record is not available yet.</p>';return;}content.innerHTML=albumMarkup(d.result);document.title=`${d.result.title} — ${d.result.artist} | Slow Grooves`;}).catch(()=>{status.hidden=false;status.textContent=content.dataset.recordId?'The latest album details could not load. Showing the saved edition.':'The album could not load. Please try again.';});}else{content.innerHTML='<p>Choose a record from the collection to open its listening room.</p>';}
</script><Motion/></body></html>
